dge-width:1px;--mm-slider-thickness:4px;--mm-slider-size:16px;--mm-slider-thumb-width:2px;--mm-slider-track:rgb(46, 56, 82);--mm-slider-thumb-fill:rgb(255, 255, 255);--mm-slider-thumb-edge:rgb(115, 184, 224);--mm-slider-thumb-hover:rgb(115, 184, 224);--mm-progress-height:8px;--mm-progress-radius:0px;--mm-progress-gap:3px;--mm-progress-track:rgb(46, 56, 82);--mm-progress-fill-color:rgb(115, 184, 224);--mm-field-radius:0px;--mm-field-width:0px;--mm-field-outline:rgb(56, 66, 87);--mm-list-radius:0px;--mm-list-hover:rgb(202, 220, 237);--mm-confirm-radius:0px" data-theme="light" role="region" aria-label="Menu preview"><div class="mm-scroll"><div class="mm-title-row"><h2 class="mm-title">Full Menu</h2><button type="button" class="mm-btn mm-btn-inline mm-close mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Close</button></div><p class="mm-hint">[F8] toggle menu</p><p class="mm-hint mm-dock-cap">Dock</p><div class="mm-drop"><button type="button" class="mm-drop-header"><span>Left</span><span class="mm-drop-arrow">▼</span></button></div><div class="mm-tabs"><button type="button" class="mm-tab" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">Main</button><button type="button" class="mm-tab" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Other</button></div><div class="mm-head-pad"></div><section class="mm-section"><button type="button" class="mm-accordion mm-section-hdr"><span>[all] Every item</span><span class="mm-mark">-</span></button><p class="mm-section-desc">One line under the title</p><div class="mm-section-body"><div class="mm-disabled"><span class="mm-tip" title="Label tip"><p class="mm-label mm-label-heading" style="text-align:center;white-space:nowrap">A label</p></span></div><div class="mm-disabled"><span class="mm-tip" title="Button tip"><button type="button" class="mm-btn mm-variant-button-fill" style="background:var(--mm-button-bg-disabled);color:var(--mm-button-text-disabled)" disabled="">Go</button></span></div><div class="mm-disabled"><label class="mm-check mm-variant-toggle-stock"><input type="checkbox" checked=""/><span>Check</span></label></div><div class="mm-disabled"><div class="mm-drop mm-variant-field-stock"><button type="button" class="mm-drop-header"><span>One</span><span class="mm-drop-arrow">▼</span></button></div></div><div class="mm-disabled"><div class="mm-number"><div class="mm-field mm-field-fill mm-variant-field-stock"><span class="mm-field-label" style="width:120px;flex:0 0 auto">Number</span><span class="mm-field-box" style="width:80px;flex:0 0 auto"><span class="mm-note">$</span><input class="mm-edit" type="text" placeholder="0" readOnly="" value="5"/><span class="mm-note">ms</span></span></div><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">-</button><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">+</button></div></div><div class="mm-field mm-field-fill mm-variant-field-stock"><span class="mm-field-label" style="width:90px;flex:0 0 auto">Text</span><span class="mm-field-box" style="width:100px;flex:0 0 auto"><input class="mm-edit" type="text" placeholder="type" readOnly="" value="hi"/></span></div><div class="mm-disabled"><div class="mm-slider mm-variant-slider-stock"><div class="mm-slider-head"><span class="mm-slider-label" style="width:100px;flex:0 0 auto">Slider</span></div><div class="mm-slider-track"><span class="mm-slider-fill" style="flex-grow:0.3"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.7"></span></div></div></div><div class="mm-radio mm-variant-choice-stock"><span class="mm-radio-label">Radio</span><div class="mm-radio-group mm-radio-inline"><button type="button" class="mm-btn mm-btn-inline" style="background:var(--mm-button-bg);color:var(--mm-button-text)">A</button><button type="button" class="mm-btn mm-btn-inline" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">Bee</button></div></div><div class="mm-disabled"><button type="button" class="mm-btn mm-keybind mm-variant-button-fill mm-variant-field-stock" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Key: <span class="mm-key-chip">LeftControl+F7</span></button></div><div class="mm-disabled"><div class="mm-stepper"><span class="mm-stepper-label">Stepper</span><span class="mm-stepper-btn">-</span><span class="mm-stepper-readout">4 pcs</span><span class="mm-stepper-btn">+</span></div></div><div class="mm-disabled"><div class="mm-progress mm-variant-progress-stock"><span class="mm-progress-label">Progress</span><span class="mm-progress-bar"><span class="mm-progress-fill" style="width:25%;background:var(--mm-button-bg-success)"></span></span><span class="mm-progress-readout">50 of 200</span></div></div><div class="mm-disabled"><span class="mm-tip" title="Multiselect tip"><div class="mm-multi mm-variant-choice-stock"><span class="mm-multi-label">Multiselect</span><div class="mm-multi-grid" style="grid-template-columns:repeat(2, 1fr)"><button type="button" class="mm-btn" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">[x] a</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">[ ] Bee</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">[x] c</button></div></div></span></div><div class="mm-disabled"><span class="mm-tip" title="Colorpicker tip"><div class="mm-color mm-variant-slider-stock"><span class="mm-color-label">Colorpicker</span><div class="mm-color-swatch" style="background:rgba(64, 128, 191, 1)"></div><div class="mm-color-row"><span class="mm-color-key">R</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0.25;background:#e64040"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.75"></span></div><span class="mm-color-value">0.25</span></div><div class="mm-color-row"><span class="mm-color-key">G</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0.5;background:#4dcc4d"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.5"></span></div><span class="mm-color-value">0.50</span></div><div class="mm-color-row"><span class="mm-color-key">B</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0.75;background:#4d80ff"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.25"></span></div><span class="mm-color-value">0.75</span></div></div></span></div><div class="mm-disabled"><span class="mm-tip" title="Row tip"><div class="mm-row"><button type="button" class="mm-btn mm-btn-inline mm-variant-button-fill" style="background:var(--mm-button-bg-primary);color:var(--mm-button-text-primary)">In row</button><label class="mm-check mm-variant-toggle-stock"><input type="checkbox"/><span>Row check</span></label><div class="mm-number"><div class="mm-field mm-variant-field-stock"><span class="mm-field-label">Row number</span><span class="mm-field-box" style="width:72px;flex:0 0 auto"><span class="mm-note">#</span><input class="mm-edit" type="text" readOnly="" value="0"/><span class="mm-note">x</span></span></div><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">-</button><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">+</button></div><div class="mm-slider mm-slider-inline mm-variant-slider-stock"><div class="mm-slider-head"><span class="mm-slider-label">Row slider</span></div><div class="mm-slider-track"><span class="mm-slider-fill" style="flex-grow:0"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div></div><div class="mm-stepper"><span class="mm-stepper-label">Row stepper</span><span class="mm-stepper-btn">-</span><span class="mm-stepper-readout">0</span><span class="mm-stepper-btn">+</span></div><div class="mm-progress mm-variant-progress-stock"><span class="mm-progress-label">Row progress</span><span class="mm-progress-bar"><span class="mm-progress-fill" style="width:0%;background:var(--mm-button-bg-danger)"></span></span><span class="mm-progress-readout">0%</span></div><p class="mm-label mm-label-warning" style="text-align:right;white-space:nowrap">Row label</p><div class="mm-field mm-variant-field-stock"><span class="mm-field-label">Row text</span><span class="mm-field-box" style="width:72px;flex:0 0 auto"><input class="mm-edit" type="text" readOnly="" value=""/></span></div></div></span></div><div class="mm-disabled"><span class="mm-tip" title="Fold tip"><div class="mm-fold"><button type="button" class="mm-accordion"><span>Fold</span><span class="mm-mark">-</span></button><div class="mm-fold-body"><button type="button" class="mm-btn mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">In fold</button><div class="mm-drop mm-variant-field-stock"><button type="button" class="mm-drop-header"><span>Select...</span><span class="mm-drop-arrow">▼</span></button></div><div class="mm-radio mm-variant-choice-stock"><span class="mm-radio-label">Fold radio</span><div class="mm-radio-group"><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">p</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">q</button></div></div><button type="button" class="mm-btn mm-keybind mm-variant-button-fill mm-variant-field-stock" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Fold key: <span class="mm-key-chip">F9</span></button><div class="mm-slider mm-variant-slider-stock"><div class="mm-slider-head"><span class="mm-slider-label" style="width:60px;flex:0 0 auto">Fold slider</span><span class="mm-slider-value">0</span></div><div class="mm-slider-track"><span class="mm-slider-fill" style="flex-grow:0"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div></div><span class="mm-tip" title="Fold stepper tip"><div class="mm-stepper"><span class="mm-stepper-label">Fold stepper</span><span class="mm-stepper-btn">-</span><span class="mm-stepper-readout">0</span><span class="mm-stepper-btn">+</span></div></span><span class="mm-tip" title="Fold progress tip"><div class="mm-progress mm-variant-progress-stock"><span class="mm-progress-label">Fold progress</span><span class="mm-progress-bar"><span class="mm-progress-fill" style="width:25%"></span></span><span class="mm-progress-readout">25%</span></div></span><div class="mm-multi mm-variant-choice-stock"><span class="mm-multi-label">Fold multiselect</span><div class="mm-multi-grid" style="grid-template-columns:repeat(4, 1fr)"><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">[ ] p</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">[x] q</button></div></div><div class="mm-color mm-variant-slider-stock"><span class="mm-color-label">Fold colorpicker</span><div class="mm-color-swatch" style="background:rgba(255, 0, 0, 1)"></div><div class="mm-color-row"><span class="mm-color-key">R</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:1;background:#e64040"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0"></span></div><span class="mm-color-value">1.00</span></div><div class="mm-color-row"><span class="mm-color-key">G</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0;background:#4dcc4d"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div><span class="mm-color-value">0.00</span></div><div class="mm-color-row"><span class="mm-color-key">B</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0;background:#4d80ff"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div><span class="mm-color-value">0.00</span></div><div class="mm-color-row"><span class="mm-color-key">A</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:1"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0"></span></div><span class="mm-color-value">1.00</span></div></div><div class="mm-sep"></div><div class="mm-row"><div class="mm-disabled"><button type="button" class="mm-btn mm-btn-inline mm-variant-button-fill" style="background:var(--mm-button-bg-disabled);color:var(--mm-button-text-disabled)" disabled="">Fold row button</button></div></div></div></div></span></div></div></section><div class="mm-foot"></div></div></div></div>"`;
