exports[`MenuPreview > draws dark with the same markup as before stage 2 1`] = `"<div class="mm-stage dock-left"><div class="mm-panel mm-header-stock mm-section-stock" style="--mm-pad-left:16px;--mm-pad-top:14px;--mm-pad-right:16px;--mm-pad-bottom:14px;--mm-font-title:16px;--mm-font-hint:12px;--mm-font-item:13px;--mm-font-section:14px;--mm-font-dropdown:13px;--mm-panel-bg:rgba(28, 28, 31, 0.9);--mm-panel-border:rgba(158, 158, 163, 0.9);--mm-text-primary:rgb(235, 235, 237);--mm-text-muted:rgb(158, 158, 163);--mm-text-accent:rgb(31, 184, 179);--mm-text-status:rgb(212, 176, 56);--mm-button-bg:rgb(51, 51, 54);--mm-button-text:rgb(235, 235, 237);--mm-button-bg-primary:rgb(20, 87, 199);--mm-button-text-primary:rgb(255, 255, 255);--mm-button-bg-secondary:rgb(82, 82, 87);--mm-button-text-secondary:rgb(235, 235, 237);--mm-button-bg-success:rgb(20, 107, 71);--mm-button-text-success:rgb(235, 250, 240);--mm-button-bg-danger:rgb(184, 46, 56);--mm-button-text-danger:rgb(255, 255, 255);--mm-button-bg-warning:rgb(230, 173, 26);--mm-button-text-warning:rgb(26, 23, 15);--mm-button-bg-info:rgb(20, 133, 148);--mm-button-text-info:rgb(230, 250, 250);--mm-button-bg-active:rgb(26, 92, 71);--mm-button-text-active:rgb(184, 242, 214);--mm-button-bg-disabled:rgb(36, 36, 38);--mm-button-text-disabled:rgb(102, 102, 107);--mm-section-header-bg:rgb(41, 41, 43);--mm-section-mark:rgb(158, 158, 163);--mm-field-bg:rgb(15, 15, 18);--mm-field-text:rgb(240, 240, 240);--mm-field-hint:rgb(128, 128, 133);--mm-dropdown-header-bg:rgb(51, 51, 54);--mm-dropdown-header-text:rgb(235, 235, 237);--mm-dropdown-option-bg:rgb(20, 20, 23);--mm-dropdown-option-text:rgb(235, 235, 237);--mm-dropdown-more:rgb(158, 158, 163);--mm-overlay-dim:rgba(10, 10, 13, 0.62);--mm-confirm-card-bg:rgba(41, 41, 43, 0.98);--mm-confirm-divider:rgb(77, 77, 82);--mm-button-hover:rgb(75, 75, 78);--mm-button-pressed:rgb(45, 45, 47);--mm-button-primary-hover:rgb(49, 107, 206);--mm-button-primary-pressed:rgb(18, 76, 175);--mm-button-secondary-hover:rgb(102, 102, 107);--mm-button-secondary-pressed:rgb(72, 72, 76);--mm-button-success-hover:rgb(49, 125, 93);--mm-button-success-pressed:rgb(18, 94, 63);--mm-button-danger-hover:rgb(192, 71, 80);--mm-button-danger-pressed:rgb(162, 40, 49);--mm-button-warning-hover:rgb(233, 183, 53);--mm-button-warning-pressed:rgb(202, 153, 22);--mm-button-info-hover:rgb(49, 147, 161);--mm-button-info-pressed:rgb(18, 117, 130);--mm-text:rgb(235, 235, 237);--mm-muted:rgb(158, 158, 163);--mm-accent:rgb(31, 184, 179);--mm-accent-text:rgb(15, 15, 18);--mm-surface:rgb(51, 51, 54);--mm-line:rgb(77, 77, 82);--mm-track:rgb(51, 51, 54);--mm-warning:rgb(230, 173, 26);--mm-panel-radius:0px;--mm-panel-width:0px;--mm-panel-fill:rgba(28, 28, 31, 0.9);--mm-panel-outline:rgba(158, 158, 163, 0.9);--mm-panel-blur:none;--mm-panel-shadow:none;--mm-panel-rim-light:rgba(255, 255, 255, 0.7);--mm-panel-rim-dark:rgba(0, 0, 0, 0.25);--mm-panel-rim-inset:4px;--mm-header-line:rgb(77, 77, 82);--mm-header-badge-fill:rgba(28, 53, 54, 0.916);--mm-header-badge-radius:0px;--mm-header-tape:8px;--mm-header-tape-alt:rgba(0, 0, 0, 0.85);--mm-header-strip:4px;--mm-header-bar-fill:rgb(31, 184, 179);--mm-header-bar-text:rgb(15, 15, 18);--mm-header-bar-hint:rgba(15, 15, 18, 0.8);--mm-title-color:rgb(235, 235, 237);--mm-body-color:rgb(235, 235, 237);--mm-hint-color:rgb(158, 158, 163);--mm-data-color:rgb(31, 184, 179);--mm-section-color:rgb(158, 158, 163);--mm-section-line:rgb(77, 77, 82);--mm-section-text-color:rgb(158, 158, 163);--mm-button-radius:0px;--mm-toggle-w:36px;--mm-toggle-h:20px;--mm-toggle-track-on:rgb(31, 184, 179);--mm-toggle-track-off:rgba(73, 73, 76, 0.922);--mm-toggle-knob-on:rgb(255, 255, 255);--mm-toggle-knob-off:rgb(255, 255, 255);--mm-toggle-box-radius:0px;--mm-toggle-check-off:rgba(235, 235, 237, 0);--mm-toggle-check-on:rgb(31, 184, 179);--mm-toggle-check-edge:rgb(235, 235, 237);--mm-toggle-check-edge-on:rgb(31, 184, 179);--mm-toggle-check-mark:rgb(15, 15, 18);--mm-toggle-check-edge-width:1px;--mm-slider-thickness:4px;--mm-slider-size:16px;--mm-slider-thumb-width:2px;--mm-slider-track:rgb(51, 51, 54);--mm-slider-thumb-fill:rgb(255, 255, 255);--mm-slider-thumb-edge:rgb(31, 184, 179);--mm-slider-thumb-hover:rgb(31, 184, 179);--mm-progress-height:8px;--mm-progress-radius:0px;--mm-progress-gap:3px;--mm-progress-track:rgb(51, 51, 54);--mm-progress-fill-color:rgb(31, 184, 179);--mm-field-radius:0px;--mm-field-width:0px;--mm-field-outline:rgb(77, 77, 82);--mm-list-radius:0px;--mm-list-hover:rgb(18, 49, 50);--mm-confirm-radius:0px" data-theme="dark" role="region" aria-label="Menu preview"><div class="mm-scroll"><div class="mm-title-row"><h2 class="mm-title">Full Menu</h2><button type="button" class="mm-btn mm-btn-inline mm-close mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Close</button></div><p class="mm-hint">[F8] toggle menu</p><p class="mm-hint mm-dock-cap">Dock</p><div class="mm-drop"><button type="button" class="mm-drop-header"><span>Left</span><span class="mm-drop-arrow">▼</span></button></div><div class="mm-tabs"><button type="button" class="mm-tab" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">Main</button><button type="button" class="mm-tab" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Other</button></div><div class="mm-head-pad"></div><section class="mm-section"><button type="button" class="mm-accordion mm-section-hdr"><span>[all] Every item</span><span class="mm-mark">-</span></button><p class="mm-section-desc">One line under the title</p><div class="mm-section-body"><div class="mm-disabled"><span class="mm-tip" title="Label tip"><p class="mm-label mm-label-heading" style="text-align:center;white-space:nowrap">A label</p></span></div><div class="mm-disabled"><span class="mm-tip" title="Button tip"><button type="button" class="mm-btn mm-variant-button-fill" style="background:var(--mm-button-bg-disabled);color:var(--mm-button-text-disabled)" disabled="">Go</button></span></div><div class="mm-disabled"><label class="mm-check mm-variant-toggle-stock"><input type="checkbox" checked=""/><span>Check</span></label></div><div class="mm-disabled"><div class="mm-drop mm-variant-field-stock"><button type="button" class="mm-drop-header"><span>One</span><span class="mm-drop-arrow">▼</span></button></div></div><div class="mm-disabled"><div class="mm-number"><div class="mm-field mm-field-fill mm-variant-field-stock"><span class="mm-field-label" style="width:120px;flex:0 0 auto">Number</span><span class="mm-field-box" style="width:80px;flex:0 0 auto"><span class="mm-note">$</span><input class="mm-edit" type="text" placeholder="0" readOnly="" value="5"/><span class="mm-note">ms</span></span></div><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">-</button><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">+</button></div></div><div class="mm-field mm-field-fill mm-variant-field-stock"><span class="mm-field-label" style="width:90px;flex:0 0 auto">Text</span><span class="mm-field-box" style="width:100px;flex:0 0 auto"><input class="mm-edit" type="text" placeholder="type" readOnly="" value="hi"/></span></div><div class="mm-disabled"><div class="mm-slider mm-variant-slider-stock"><div class="mm-slider-head"><span class="mm-slider-label" style="width:100px;flex:0 0 auto">Slider</span></div><div class="mm-slider-track"><span class="mm-slider-fill" style="flex-grow:0.3"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.7"></span></div></div></div><div class="mm-radio mm-variant-choice-stock"><span class="mm-radio-label">Radio</span><div class="mm-radio-group mm-radio-inline"><button type="button" class="mm-btn mm-btn-inline" style="background:var(--mm-button-bg);color:var(--mm-button-text)">A</button><button type="button" class="mm-btn mm-btn-inline" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">Bee</button></div></div><div class="mm-disabled"><button type="button" class="mm-btn mm-keybind mm-variant-button-fill mm-variant-field-stock" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Key: <span class="mm-key-chip">LeftControl+F7</span></button></div><div class="mm-disabled"><div class="mm-stepper"><span class="mm-stepper-label">Stepper</span><span class="mm-stepper-btn">-</span><span class="mm-stepper-readout">4 pcs</span><span class="mm-stepper-btn">+</span></div></div><div class="mm-disabled"><div class="mm-progress mm-variant-progress-stock"><span class="mm-progress-label">Progress</span><span class="mm-progress-bar"><span class="mm-progress-fill" style="width:25%;background:var(--mm-button-bg-success)"></span></span><span class="mm-progress-readout">50 of 200</span></div></div><div class="mm-disabled"><span class="mm-tip" title="Multiselect tip"><div class="mm-multi mm-variant-choice-stock"><span class="mm-multi-label">Multiselect</span><div class="mm-multi-grid" style="grid-template-columns:repeat(2, 1fr)"><button type="button" class="mm-btn" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">[x] a</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">[ ] Bee</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">[x] c</button></div></div></span></div><div class="mm-disabled"><span class="mm-tip" title="Colorpicker tip"><div class="mm-color mm-variant-slider-stock"><span class="mm-color-label">Colorpicker</span><div class="mm-color-swatch" style="background:rgba(64, 128, 191, 1)"></div><div class="mm-color-row"><span class="mm-color-key">R</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0.25;background:#e64040"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.75"></span></div><span class="mm-color-value">0.25</span></div><div class="mm-color-row"><span class="mm-color-key">G</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0.5;background:#4dcc4d"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.5"></span></div><span class="mm-color-value">0.50</span></div><div class="mm-color-row"><span class="mm-color-key">B</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0.75;background:#4d80ff"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0.25"></span></div><span class="mm-color-value">0.75</span></div></div></span></div><div class="mm-disabled"><span class="mm-tip" title="Row tip"><div class="mm-row"><button type="button" class="mm-btn mm-btn-inline mm-variant-button-fill" style="background:var(--mm-button-bg-primary);color:var(--mm-button-text-primary)">In row</button><label class="mm-check mm-variant-toggle-stock"><input type="checkbox"/><span>Row check</span></label><div class="mm-number"><div class="mm-field mm-variant-field-stock"><span class="mm-field-label">Row number</span><span class="mm-field-box" style="width:72px;flex:0 0 auto"><span class="mm-note">#</span><input class="mm-edit" type="text" readOnly="" value="0"/><span class="mm-note">x</span></span></div><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">-</button><button type="button" class="mm-btn mm-btn-inline mm-step mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">+</button></div><div class="mm-slider mm-slider-inline mm-variant-slider-stock"><div class="mm-slider-head"><span class="mm-slider-label">Row slider</span></div><div class="mm-slider-track"><span class="mm-slider-fill" style="flex-grow:0"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div></div><div class="mm-stepper"><span class="mm-stepper-label">Row stepper</span><span class="mm-stepper-btn">-</span><span class="mm-stepper-readout">0</span><span class="mm-stepper-btn">+</span></div><div class="mm-progress mm-variant-progress-stock"><span class="mm-progress-label">Row progress</span><span class="mm-progress-bar"><span class="mm-progress-fill" style="width:0%;background:var(--mm-button-bg-danger)"></span></span><span class="mm-progress-readout">0%</span></div><p class="mm-label mm-label-warning" style="text-align:right;white-space:nowrap">Row label</p><div class="mm-field mm-variant-field-stock"><span class="mm-field-label">Row text</span><span class="mm-field-box" style="width:72px;flex:0 0 auto"><input class="mm-edit" type="text" readOnly="" value=""/></span></div></div></span></div><div class="mm-disabled"><span class="mm-tip" title="Fold tip"><div class="mm-fold"><button type="button" class="mm-accordion"><span>Fold</span><span class="mm-mark">-</span></button><div class="mm-fold-body"><button type="button" class="mm-btn mm-variant-button-fill" style="background:var(--mm-button-bg);color:var(--mm-button-text)">In fold</button><div class="mm-drop mm-variant-field-stock"><button type="button" class="mm-drop-header"><span>Select...</span><span class="mm-drop-arrow">▼</span></button></div><div class="mm-radio mm-variant-choice-stock"><span class="mm-radio-label">Fold radio</span><div class="mm-radio-group"><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">p</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">q</button></div></div><button type="button" class="mm-btn mm-keybind mm-variant-button-fill mm-variant-field-stock" style="background:var(--mm-button-bg);color:var(--mm-button-text)">Fold key: <span class="mm-key-chip">F9</span></button><div class="mm-slider mm-variant-slider-stock"><div class="mm-slider-head"><span class="mm-slider-label" style="width:60px;flex:0 0 auto">Fold slider</span><span class="mm-slider-value">0</span></div><div class="mm-slider-track"><span class="mm-slider-fill" style="flex-grow:0"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div></div><span class="mm-tip" title="Fold stepper tip"><div class="mm-stepper"><span class="mm-stepper-label">Fold stepper</span><span class="mm-stepper-btn">-</span><span class="mm-stepper-readout">0</span><span class="mm-stepper-btn">+</span></div></span><span class="mm-tip" title="Fold progress tip"><div class="mm-progress mm-variant-progress-stock"><span class="mm-progress-label">Fold progress</span><span class="mm-progress-bar"><span class="mm-progress-fill" style="width:25%"></span></span><span class="mm-progress-readout">25%</span></div></span><div class="mm-multi mm-variant-choice-stock"><span class="mm-multi-label">Fold multiselect</span><div class="mm-multi-grid" style="grid-template-columns:repeat(4, 1fr)"><button type="button" class="mm-btn" style="background:var(--mm-button-bg);color:var(--mm-button-text)">[ ] p</button><button type="button" class="mm-btn" style="background:var(--mm-button-bg-active);color:var(--mm-button-text-active)">[x] q</button></div></div><div class="mm-color mm-variant-slider-stock"><span class="mm-color-label">Fold colorpicker</span><div class="mm-color-swatch" style="background:rgba(255, 0, 0, 1)"></div><div class="mm-color-row"><span class="mm-color-key">R</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:1;background:#e64040"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0"></span></div><span class="mm-color-value">1.00</span></div><div class="mm-color-row"><span class="mm-color-key">G</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0;background:#4dcc4d"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div><span class="mm-color-value">0.00</span></div><div class="mm-color-row"><span class="mm-color-key">B</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:0;background:#4d80ff"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:1"></span></div><span class="mm-color-value">0.00</span></div><div class="mm-color-row"><span class="mm-color-key">A</span><div class="mm-slider-track mm-color-track"><span class="mm-slider-fill" style="flex-grow:1"></span><span class="mm-slider-knob"></span><span class="mm-slider-rest" style="flex-grow:0"></span></div><span class="mm-color-value">1.00</span></div></div><div class="mm-sep"></div><div class="mm-row"><div class="mm-disabled"><button type="button" class="mm-btn mm-btn-inline mm-variant-button-fill" style="background:var(--mm-button-bg-disabled);color:var(--mm-button-text-disabled)" disabled="">Fold row button</button></div></div></div></div></span></div></div></section><div class="mm-foot"></div></div></div></div>"`;

exports[`MenuPreview > draws light with the same markup as before stage 2 1`] = `"<div class="mm-stage dock-left"><div class="mm-panel mm-header-stock mm-section-stock" style="--mm-pad-left:20px;--mm-pad-top:18px;--mm-pad-right:20px;--mm-pad-bottom:18px;--mm-font-title:16px;--mm-font-hint:12px;--mm-font-item:13px;--mm-font-section:14px;--mm-font-dropdown:13px;--mm-panel-bg:rgba(13, 18, 31, 0.92);--mm-panel-border:rgba(13, 18, 31, 0.92);--mm-text-primary:rgb(242, 242, 250);--mm-text-muted:rgb(184, 194, 209);--mm-text-accent:rgb(115, 184, 224);--mm-text-status:rgb(212, 176, 56);--mm-button-bg:rgb(46, 56, 82);--mm-button-text:rgb(242, 242, 250);--mm-button-bg-primary:rgb(13, 110, 252);--mm-button-text-primary:rgb(255, 255, 255);--mm-button-bg-secondary:rgb(107, 117, 125);--mm-button-text-secondary:rgb(255, 255, 255);--mm-button-bg-success:rgb(26, 135, 84);--mm-button-text-success:rgb(255, 255, 255);--mm-button-bg-danger:rgb(219, 54, 69);--mm-button-text-danger:rgb(255, 255, 255);--mm-button-bg-warning:rgb(255, 194, 8);--mm-button-text-warning:rgb(20, 23, 26);--mm-button-bg-info:rgb(13, 201, 240);--mm-button-text-info:rgb(20, 23, 26);--mm-button-bg-active:rgb(31, 102, 71);--mm-button-text-active:rgb(209, 250, 224);--mm-button-bg-disabled:rgb(31, 36, 46);--mm-button-text-disabled:rgb(115, 122, 133);--mm-section-header-bg:rgb(26, 33, 51);--mm-section-mark:rgb(184, 194, 209);--mm-field-bg:rgb(224, 230, 240);--mm-field-text:rgb(15, 18, 26);--mm-field-hint:rgb(89, 97, 115);--mm-dropdown-header-bg:rgb(56, 71, 102);--mm-dropdown-header-text:rgb(250, 250, 255);--mm-dropdown-option-bg:rgb(224, 230, 240);--mm-dropdown-option-text:rgb(15, 18, 26);--mm-dropdown-more:rgb(179, 191, 217);--mm-overlay-dim:rgba(5, 8, 13, 0.62);--mm-confirm-card-bg:rgba(20, 26, 41, 0.98);--mm-confirm-divider:rgb(56, 66, 87);--mm-button-hover:rgb(71, 80, 102);--mm-button-pressed:rgb(40, 49, 72);--mm-button-primary-hover:rgb(42, 127, 253);--mm-button-primary-pressed:rgb(11, 96, 222);--mm-button-secondary-h